# Generic ESP32 DevKit V1: 4 MB flash, no onboard display.
CONFIG_DISPLAY_ENABLED=n

# PCM5102: adjacent header pins VIN, GND, D13, D12, D14.
# GPIO12 is a boot strap; DAC DIN must not pull it high during reset.
CONFIG_I2S_BCK_IO=14
CONFIG_I2S_WS_IO=13
CONFIG_I2S_DO_IO=12
# Hold the DAC SCK input low using the adjacent sixth header pin.
CONFIG_I2S_GND_IO=27
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_VCC_IO=-1
CONFIG_DAC_I2C_SDA=-1
CONFIG_DAC_I2C_SCL=-1
CONFIG_SPDIF_DO_IO=-1

# DevKit V1 uses an ESP32-WROOM without external PSRAM.
CONFIG_SPIRAM=n
CONFIG_SPIRAM_SPEED_80M=n
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=n
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=n
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=n
